# Cabeçalhos de segurança. Lidos pelo Cloudflare (Workers/Pages) e pelo
# Netlify; no servidor próprio, ver deploy/nginx.conf (mesmos valores).
# Se algo deixar de carregar depois de publicar, abra o console do
# navegador: o erro de "Content Security Policy" diz o endereço que falta.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' https://esm.sh https://cdn.sheetjs.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://esm.sh https://cdn.sheetjs.com https://fonts.googleapis.com https://fonts.gstatic.com; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

/sw.js
  Cache-Control: no-cache

/config.js
  Cache-Control: no-cache

/assets/*
  Cache-Control: public, max-age=86400
