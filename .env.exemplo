# ============================================================
#  Copie este arquivo para ".env" (na raiz do projeto) e preencha.
#  O .env NUNCA vai para o GitHub (está no .gitignore) e NUNCA vai
#  para public/: estas chaves dão acesso total ao Qlik e ao banco.
#  Usado só pelos scripts:  npm run qlik:simular · npm run qlik:clientes
#                           npm run importar:planilhas -- … --enviar
# ============================================================

# ---------- QLIK CLOUD (a mesma do Painel Vendedor) ----------
# Endereço do tenant, sem https://
QLIK_TENANT=terrazoo.us.qlikcloud.com
# Qlik Cloud → Perfil → Configurações → Chaves de API → Gerar nova chave
QLIK_API_KEY=
# ID do app que tem a base de vendas/clientes (aparece na URL: /sense/app/<ID>/...)
QLIK_APP_ID=

# Nome exato dos campos no app do Qlik (deixe vazio para não usar o campo)
QLIK_CAMPO_CODIGO=Cód. Cliente
QLIK_CAMPO_NOME=Razão Social Cliente
QLIK_CAMPO_FANTASIA=
QLIK_CAMPO_DOCUMENTO=CPF CNPJ Cliente
QLIK_CAMPO_CIDADE=Cidade
QLIK_CAMPO_UF=UF
QLIK_CAMPO_VENDEDOR=Vendedor
# Quando o cliente aparece com dois vendedores/cidades, fica o de maior valor nesta medida
QLIK_MEDIDA=Count(1)

# ---------- SUPABASE (gravação) ----------
# Project Settings → Data API → Project URL
SUPABASE_URL=https://clfnsuzglasmguzwodxq.supabase.co
# Project Settings → API Keys → service_role (secret). NÃO é a chave publishable do config.js.
SUPABASE_SERVICE_ROLE_KEY=
