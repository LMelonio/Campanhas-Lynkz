// Cloudflare Workers — só arquivos estáticos (sem código no servidor).
// Publica a pasta public/. Os cabeçalhos de segurança vêm de public/_headers.
// Documentação: PUBLICAR.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campanhas-lynkz",   // TEM de ser igual ao nome do Worker no Cloudflare (senão publica em outro Worker)
  "compatibility_date": "2025-11-01",
  "main": "worker/index.js",
  // Segredo (não vai neste arquivo):  npx wrangler secret put QLIK_API_KEY
  "vars": {
    "QLIK_TENANT": "terrazoo.us.qlikcloud.com",
    "QLIK_APP_ID": "dd64c3d7-6ab3-4819-9805-fa8828633dd4",
    "SUPABASE_URL": "https://clfnsuzglasmguzwodxq.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_BzXFZgmdRRsMWtzUJ4Ng8w_zJs5T_bt"
  },
  // Limite de consultas ao Qlik por usuário, valendo para todos os servidores do Cloudflare.
  // (Sem este bloco o Worker usa um limite por instância, mais fraco.)
  "ratelimits": [
    { "name": "LIMITE_QLIK", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],
  "assets": {
    "run_worker_first": ["/api/*"],
    "directory": "./public",
    "not_found_handling": "none"
  },
  "observability": { "enabled": true }
}
